    "issue_2": {
      "id": "HW_002",
      "title": "Custom portraits fail to load on real GBA hardware",
      "description": "Custom portrait feature worked on emulators but failed to load custom portraits on real hardware",
      "severity": "Medium",
      "priority": "High",
      "affected_platforms": ["GBA SP"],
      "symptoms": [
        "Default portraits displayed instead of custom",
        "No error messages",
        "Feature silently failed"
