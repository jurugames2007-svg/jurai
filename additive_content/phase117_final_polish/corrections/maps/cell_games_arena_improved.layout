  "metadata": {
    "designer": "Javi (MapDesigner)",
    "version": "2.0",
    "last_modified": "2026-08-06",
    "improvements": [
      "Added 3 platform levels (0-3)",
      "Added ladders to connect platforms",
      "Added 2 NPCs (Announcer and Referee)",
      "Added battle pods as examineable objects",
      "Fixed collision to properly handle different height levels",
      "Improved visual hierarchy with height-based rendering"
    ],
    "notes": "Players can now fight on different levels, adding strategic depth to battles."
  }
