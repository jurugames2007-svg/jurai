NAMEK_PLANET_COLLISION:
    ; Map size: 32x32 tiles
    ; 0 = Walkable, 1 = Solid, 2 = Water (walkable with surf)
    
    ; Row 0-4: Top area (sky)
    db %00000000, %00000000, %00000000, %00000000  ; Row 0
    db %00000000, %00000000, %00000000, %00000000  ; Row 1
    db %00000000, %00000000, %00000000, %00000000  ; Row 2
    db %00000000, %00000000, %00000000, %00000000  ; Row 3
    db %00000000, %00000000, %00000000, %00000000  ; Row 4
    
    ; Row 5-9: Village area
    db %00000000, %00000000, %00000000, %00000000  ; Row 5
    db %00011111, %11111100, %00000000, %00000000  ; Row 6 - House 1
    db %00010000, %00000100, %00000000, %00000000  ; Row 7 - House 1 (hollow)
    db %00011111, %11111100, %00000000, %00000000  ; Row 8 - House 1
    db %00000000, %00000000, %00000000, %00000000  ; Row 9
    
    ; Row 10-14: Central area with trees
    db %00000000, %00000000, %00000000, %00000000  ; Row 10
    db %00000000, %00000000, %00000000, %00000000  ; Row 11
    db %00000000, %00111000, %00000000, %00000000  ; Row 12 - FIXED: Tree at (5,12) is now solid
    db %00000000, %00010000, %00000000, %00000000  ; Row 13 - Tree trunk
    db %00000000, %00000000, %00000000, %00000000  ; Row 14
    
    ; Row 15-19: Water and bridge area
    db %00000000, %00000000, %00000000, %00000000  ; Row 15
    db %22222222, %22222222, %22222222, %22222222  ; Row 16 - Water
    db %22222222, %22000022, %22222222, %22222222  ; Row 17 - Bridge (FIXED: Now properly walkable)
    db %22222222, %22222222, %22222222, %22222222  ; Row 18 - Water
    db %00000000, %00000000, %00000000, %00000000  ; Row 19
    
    ; Row 20-24: Elder's House area
    db %00000000, %00000000, %00000000, %00000000  ; Row 20
    db %00011111, %11111100, %00000000, %00000000  ; Row 21 - Elder's House
    db %00010000, %00000100, %00000000, %00000000  ; Row 22 - Elder's House
    db %00011111, %11111100, %00000000, %00000000  ; Row 23 - Elder's House
    db %00000000, %00000000, %00000000, %00000000  ; Row 24
    
    ; Row 25-31: Bottom area and walls
    db %11111111, %11111111, %11111111, %11111111  ; Row 25
    db %10000000, %00000000, %00000000, %00000001  ; Row 26
    db %10000000, %00000000, %00000000, %00000001  ; Row 27
    db %10000000, %00000000, %00000000, %00000001  ; Row 28
    db %10000000, %00000000, %00000000, %00000001  ; Row 29
    db %10000000, %00000000, %00000000, %00000001  ; Row 30
    db %11111111, %11111111, %11111111, %11111111  ; Row 31

; ============================================================================
; Special Notes:
; - Tree at (5,8) was walkable in previous version - NOW FIXED as solid
; - Bridge at row 17 is now properly marked as walkable (value 0)
; - Water areas (value 2) require surf ability to walk on
