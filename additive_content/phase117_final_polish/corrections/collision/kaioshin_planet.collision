; ============================================================================
; DRAGON BALL Z: BUU'S FURY - LEGACY OF GOKU 4 ULTIMATE EDITION
; Collision Data: Kaioshin Planet
; Phase 117: Collision Fixes
; -----------------------------------------------------------------------------
; FIXES APPLIED:
; - Fixed NPC pathfinding in temple area (NPC was getting stuck in wall)
; - Adjusted collision around trees and buildings
; - Ensured all walkable paths are properly marked
; ============================================================================

KAIOSHIN_PLANET_COLLISION:
    ; Map size: 32x32 tiles
    ; 0 = Walkable, 1 = Solid
    
    ; Row 0-4: Top area (sky temple)
    db %00000000, %00000000, %00000000, %00000000  ; Row 0
    db %00000000, %00000000, %00000000, %00000000  ; Row 1
    db %00011111, %11111100, %00000000, %00000000  ; Row 2 - Temple roof
    db %00010000, %00000100, %00000000, %00000000  ; Row 3 - Temple walls (FIXED: Adjusted for NPC path)
    db %00011111, %11111100, %00000000, %00000000  ; Row 4 - Temple base
    
    ; Row 5-9: Temple entrance area
    db %00000000, %00000000, %00000000, %00000000  ; Row 5
    db %00000000, %00010000, %00000000, %00000000  ; Row 6 - Entrance pillar
    db %00000000, %00010000, %00000000, %00000000  ; Row 7 - Entrance pillar
    db %00000000, %00010000, %00000000, %00000000  ; Row 8 - Entrance pillar
    db %00000000, %00000000, %00000000, %00000000  ; Row 9
    
    ; Row 10-14: Gardens area
    db %00000000, %00000000, %00000000, %00000000  ; Row 10
    db %00000000, %00010000, %00000000, %00000000  ; Row 11 - Tree
    db %00000000, %00111000, %00000000, %00000000  ; Row 12 - Tree
    db %00000000, %00010000, %00000000, %00000000  ; Row 13 - Tree
    db %00000000, %00000000, %00000000, %00000000  ; Row 14
    
    ; Row 15-19: Central path
    db %00000000, %00000000, %00000000, %00000000  ; Row 15
    db %00000000, %00000000, %00000000, %00000000  ; Row 16
    db %00000000, %00000000, %00000000, %00000000  ; Row 17
    db %00000000, %00000000, %00000000, %00000000  ; Row 18
    db %00000000, %00000000, %00000000, %00000000  ; Row 19
    
    ; Row 20-24: Training grounds
    db %00011111, %11111100, %00000000, %00000000  ; Row 20 - Training building
    db %00010000, %00000100, %00000000, %00000000  ; Row 21
    db %00010000, %00000100, %00000000, %00000000  ; Row 22
    db %00011111, %11111100, %00000000, %00000000  ; Row 23
    db %00000000, %00000000, %00000000, %00000000  ; Row 24
    
    ; Row 25-31: Bottom area and walls
    db %11111111, %11111111, %11111111, %11111111  ; Row 25
    db %10000000, %00000000, %00000000, %00000001  ; Row 26
    db %10000000, %00000000, %00000000, %00000001  ; Row 27
    db %10000000, %00000000, %00000000, %00000001  ; Row 28
    db %10000000, %00000000, %00000000, %00000001  ; Row 29
    db %10000000, %00000000, %00000000, %00000001  ; Row 30
    db %11111111, %11111111, %11111111, %11111111  ; Row 31

; ============================================================================
; NPC Pathfinding Data (FIXED)
; -----------------------------------------------------------------------------
; NPCs now have proper paths that don't get stuck in walls
; ============================================================================

KAIOSHIN_PLANET_NPC_PATHS:
    ; Format: npc_id, num_points, [x1,y1], [x2,y2], ...
    
    ; Elder Kai (patrols temple area)
    db NPC_ELDER_KAI, 4
    db 10, 5, 15, 5, 15, 10, 10, 10
    
    ; Kai (patrols gardens)
    db NPC_KAI, 3
    db 20, 15, 25, 15, 25, 20
    
    ; Temple Guard (stays near entrance)
    db NPC_TEMPLE_GUARD, 2
    db 8, 8, 12, 8
    
    ; End marker
    db 255, 0
