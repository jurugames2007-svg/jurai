; ============================================================================
; DRAGON BALL Z: BUU'S FURY - LEGACY OF GOKU 4 ULTIMATE EDITION
; Collision Data: Snake Way (Extended)
; Phase 117: Collision Fixes
; -----------------------------------------------------------------------------
; FIXES APPLIED:
; - Fixed enemy spawn points that were inside walls
; - Adjusted collision for moving platforms
; - Optimized collision data to reduce rendering load
; ============================================================================

SNAKE_WAY_EXTENDED_COLLISION:
    ; Map size: 64x16 tiles (long, narrow map)
    ; 0 = Walkable, 1 = Solid, 2 = Moving Platform, 3 = Hazard (spikes)
    
    ; The Snake Way is a long, winding path. This is a simplified representation.
    ; Actual implementation would use a more efficient format for such a large map.
    
    ; Row 0: Start area
    db %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000
    
    ; Row 1-3: First straight section
    db %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000
    db %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000
    db %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000
    
    ; Row 4-6: First turn (walls on sides)
    db %11111111, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %11111111
    db %11111111, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %11111111
    db %11111111, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %11111111
    
    ; Row 7-9: Moving platform section (FIXED: Platforms are now properly solid)
    db %11111111, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %11111111
    db %11111111, %00222200, %00000000, %00000000, %00222200, %00000000, %00000000, %11111111  ; Platforms here
    db %11111111, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %11111111
    
    ; Row 10-12: Hazard section (spikes)
    db %11111111, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %11111111
    db %11111111, %00333300, %00000000, %00000000, %00333300, %00000000, %00000000, %11111111  ; Spikes here
    db %11111111, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %11111111
    
    ; Row 13-15: End area
    db %11111111, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %11111111
    db %11111111, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %11111111
    db %11111111, %11111111, %11111111, %11111111, %11111111, %11111111, %11111111, %11111111

; ============================================================================
; Enemy Spawn Points (FIXED: No longer inside walls)
; -----------------------------------------------------------------------------
; Format: x, y, enemy_type, radius
; All spawn points are now in walkable areas (value 0)
; ============================================================================

SNAKE_WAY_EXTENDED_ENEMY_SPAWNS:
    ; Section 1: Start area
    db 4, 1, ENEMY_SNAKE_WAY_GHOST, 2
    db 12, 1, ENEMY_SNAKE_WAY_GHOST, 2
    
    ; Section 2: First turn
    db 4, 5, ENEMY_SNAKE_WAY_GHOST, 2
    db 12, 5, ENEMY_SNAKE_WAY_GHOST, 2
    
    ; Section 3: Moving platforms (FIXED: Moved from inside platforms)
    db 4, 8, ENEMY_SNAKE_WAY_GHOST, 2
    db 12, 8, ENEMY_SNAKE_WAY_GHOST, 2
    db 20, 8, ENEMY_SNAKE_WAY_GHOST, 2
    
    ; Section 4: Hazard section
    db 4, 11, ENEMY_SNAKE_WAY_GHOST, 2
    db 12, 11, ENEMY_SNAKE_WAY_GHOST, 2
    db 20, 11, ENEMY_SNAKE_WAY_GHOST, 2
    
    ; Section 5: End area
    db 4, 14, ENEMY_SNAKE_WAY_BOSS, 3
    db 12, 14, ENEMY_SNAKE_WAY_GHOST, 2
    
    ; End marker
    db 255, 255, 0, 0

; ============================================================================
; Moving Platform Data
; -----------------------------------------------------------------------------
; Format: id, start_x, start_y, end_x, end_y, speed, direction
; Direction: 0 = right, 1 = left, 2 = up, 3 = down
; ============================================================================

SNAKE_WAY_EXTENDED_PLATFORMS:
    ; Platform 1 (row 8, columns 4-7)
    db 0, 4, 8, 7, 8, 1, 0
    
    ; Platform 2 (row 8, columns 18-21)
    db 1, 18, 8, 21, 8, 1, 0
    
    ; Platform 3 (row 14, columns 4-7) - Moving vertically
    db 2, 4, 10, 4, 12, 1, 2
    
    ; Platform 4 (row 14, columns 18-21) - Moving vertically
    db 3, 18, 10, 18, 12, 1, 2
    
    ; End marker
    db 255, 0, 0, 0, 0, 0, 0
