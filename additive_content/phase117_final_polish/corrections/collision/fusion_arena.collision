; ============================================================================
; DRAGON BALL Z: BUU'S FURY - LEGACY OF GOKU 4 ULTIMATE EDITION
; Collision Data: Fusion Arena
; Phase 117: Collision Fixes
; -----------------------------------------------------------------------------
; FIXES APPLIED:
; - Fixed floating platform that was not solid
; - Adjusted collision for fusion pedestals
; - Ensured all arena boundaries are properly marked
; ============================================================================

FUSION_ARENA_COLLISION:
    ; Map size: 24x24 tiles (smaller map for arena)
    ; 0 = Walkable, 1 = Solid, 2 = Fusion Pedestal
    
    ; Row 0-3: Top boundary
    db %11111111, %11111111, %11111111  ; Row 0
    db %10000000, %00000000, %00000001  ; Row 1
    db %10000000, %00000000, %00000001  ; Row 2
    db %10000000, %00000000, %00000001  ; Row 3
    
    ; Row 4-7: Northern area
    db %10000000, %00000000, %00000001  ; Row 4
    db %10000000, %00000000, %00000001  ; Row 5
    db %10000000, %00000000, %00000001  ; Row 6
    db %10000000, %00000000, %00000001  ; Row 7
    
    ; Row 8-11: Fusion Pedestal Area (CENTER)
    db %10000000, %00000000, %00000001  ; Row 8
    db %10000222, %22222200, %00000001  ; Row 9 - Fusion pedestal (FIXED: Now properly solid)
    db %10000222, %22222200, %00000001  ; Row 10 - Fusion pedestal
    db %10000222, %22222200, %00000001  ; Row 11 - Fusion pedestal
    
    ; Row 12-15: Southern area
    db %10000000, %00000000, %00000001  ; Row 12
    db %10000000, %00000000, %00000001  ; Row 13
    db %10000000, %00000000, %00000001  ; Row 14
    db %10000000, %00000000, %00000001  ; Row 15
    
    ; Row 16-19: Floating Platforms (FIXED: Now properly solid)
    db %10000000, %00000000, %00000001  ; Row 16
    db %10011100, %00111100, %00000001  ; Row 17 - Platform 1 (FIXED: Was walkable, now solid)
    db %10000000, %00000000, %00000001  ; Row 18
    db %10000111, %11100000, %00000001  ; Row 19 - Platform 2 (FIXED: Was walkable, now solid)
    
    ; Row 20-23: Bottom boundary
    db %10000000, %00000000, %00000001  ; Row 20
    db %10000000, %00000000, %00000001  ; Row 21
    db %10000000, %00000000, %00000001  ; Row 22
    db %11111111, %11111111, %11111111  ; Row 23

; ============================================================================
; Special Collision Notes:
; - Fusion pedestals (value 2) are solid and trigger fusion when both players stand on them
; - Floating platforms (value 1 in rows 17 and 19) are now properly solid
; - The entire map is surrounded by solid walls (value 1)
; ============================================================================

; ============================================================================
; Fusion Pedestal Logic
; -----------------------------------------------------------------------------
; When both players stand on pedestals, fusion is triggered
; ============================================================================

FUSION_ARENA_SPECIAL:
    ; Check if both players are on pedestals
    call CheckPlayer1OnPedestal
    jr nz, .no_fusion
    call CheckPlayer2OnPedestal
    jr nz, .no_fusion
    
    ; Both players are on pedestals - trigger fusion
    call TriggerFusion
    ret

.no_fusion:
    ret

CheckPlayer1OnPedestal:
    ; Check if player 1 is on a pedestal tile (value 2)
    ld a, [wPlayer1X]
    ld b, a
    ld a, [wPlayer1Y]
    ld c, a
    call GetCollisionAtPosition
    cp 2
    ret

CheckPlayer2OnPedestal:
    ; Check if player 2 is on a pedestal tile (value 2)
    ld a, [wPlayer2X]
    ld b, a
    ld a, [wPlayer2Y]
    ld c, a
    call GetCollisionAtPosition
    cp 2
    ret

; Returns collision value at (b,c) in a
GetCollisionAtPosition:
    ; Convert coordinates to collision map index
    ; ... (implementation depends on map format)
    ret
