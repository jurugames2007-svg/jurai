; ============================================================================
; DRAGON BALL Z: BUU'S FURY - LEGACY OF GOKU 4 ULTIMATE EDITION
; Character Stats: Meta-Cooler
; Phase 117: Balance Adjustments
; -----------------------------------------------------------------------------
; BALANCE NOTES:
; - Supernova Cooler now has a predictable 3-phase pattern
; - Reduced base ATK by 10% to make him less overwhelming
; - Added recovery frames after Supernova Cooler
; ============================================================================

CHARACTER_META_COOLER:
    ; Basic Info
    db "Meta-Cooler", 0
    dw SPRITE_META_COOLER
    db CLASS_VILLAIN
    db ALIGNMENT_ENEMY
    
    ; Base Stats
    db LEVEL_55
    dw HP_3200
    dw ATK_225      ; REDUCED from 250 (10% decrease)
    dw DEF_180
    dw SPD_130
    
    ; Growth Rates
    db HP_GROWTH_7
    db ATK_GROWTH_8
    db DEF_GROWTH_7
    db SPD_GROWTH_4
    
    ; Abilities
    db ABILITY_SUPERNOVA_COOLER | ABILITY_DEATH_BEAM | ABILITY_POWER_UP | ABILITY_ENERGY_ABSORPTION
    
    ; AI Settings
    db AI_SMART
    db TARGET_PLAYER
    db RANGE_LONG
    
    ; Special Flags
    db FLAG_BOSS | FLAG_CAN_SUMMON_MINIONS
    
    ; End Marker
    db 0

; ============================================================================
; Attack: Supernova Cooler
; -----------------------------------------------------------------------------
; Now has a 3-phase pattern:
; 1. Charge (1.5 seconds) - Player can move freely
; 2. Firing (1 second) - Player can try to dodge
; 3. Recovery (1 second) - Meta-Cooler is vulnerable
; -----------------------------------------------------------------------------
; Damage reduced by 15% to make it more survivable
; ============================================================================

ATTACK_SUPERNOVA_COOLER:
    db "Supernova Cooler", 0
    dw ANIMATION_SUPERNOVA_COOLER
    db ELEMENT_ICE
    db TARGET_ALL
    dw POWER_3000  ; REDUCED from 3500 (15% decrease)
    db ACCURACY_100
    db PP_1
    db EFFECT_SCREEN_FREEZE | EFFECT_SLOW
    
    ; Phase 1: Charge (90 frames = 1.5 seconds)
    db PHASE_CHARGE, 90
    db ACTION_PLAY_ANIMATION, ANIM_CHARGE
    db ACTION_PLAY_SOUND, SOUND_CHARGE
    db ACTION_WAIT, 90
    
    ; Phase 2: Firing (60 frames = 1 second)
    db PHASE_FIRING, 60
    db ACTION_PLAY_ANIMATION, ANIM_FIRE
    db ACTION_SPAWN_PROJECTILE, PROJECTILE_SUPERNOVA
    db ACTION_PLAY_SOUND, SOUND_SUPERNOVA
    db ACTION_WAIT, 60
    
    ; Phase 3: Recovery (60 frames = 1 second)
    db PHASE_RECOVERY, 60
    db ACTION_SET_VULNERABLE, 1
    db ACTION_PLAY_ANIMATION, ANIM_RECOVER
    db ACTION_WAIT, 60
    
    db 0  ; End of attack
