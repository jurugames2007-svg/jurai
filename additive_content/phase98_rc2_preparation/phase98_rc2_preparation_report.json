  "changelog_details": {
    "version": "v0.7.0-RC2",
    "release_date": "2026-09-07",
    "sections": {
      "new_features": [
        {
          "title": "Dialogue Skip System",
          "description": "Players can now skip dialogue using the L button. Features multiple skip speeds and visual feedback.",
          "impact": "High",
          "user_visible": true
        },
        {
          "title": "Voice Volume Slider",
          "description": "In-game volume control for voice clips, separate from music and sound effects.",
          "impact": "High",
          "user_visible": true
        },
        {
          "title": "Custom Character Portraits",
          "description": "Players can replace default character portraits with custom images (32x32, 16 colors).",
          "impact": "High",
          "user_visible": true
        }
      ],
      "bug_fixes": [
        {
          "title": "Save file corruption when switching languages rapidly",
          "description": "Fixed save file corruption that occurred when switching languages too quickly.",
          "severity": "Critical",
          "user_visible": true
        },
        {
          "title": "Memory leak in voice clip management system",
          "description": "Fixed memory leak that caused gradual slowdown after many voice clips were played.",
          "severity": "Critical",
          "user_visible": false
        },
        {
          "title": "Text overflow in German dialogue boxes",
          "description": "Fixed text wrapping and overflow issues in German localization.",
          "severity": "High",
          "user_visible": true
        },
        {
          "title": "Animation stuttering during complex dialogue scenes",
          "description": "Optimized animation system to prevent stuttering with many active animations.",
          "severity": "High",
          "user_visible": true
        },
        {
          "title": "Voice clips cutting off prematurely",
          "description": "Fixed audio playback timing issues that caused voice clips to cut off.",
          "severity": "High",
          "user_visible": true
        },
        {
          "title": "Localization data corruption on save/load",
          "description": "Added validation and repair for localization data in save files.",
          "severity": "High",
          "user_visible": false
        },
        {
          "title": "Portrait animations not syncing with voice",
          "description": "Fixed timing synchronization between portrait animations and voice clips.",
          "severity": "High",
          "user_visible": true
        }
      ],
      "improvements": [
        {
          "title": "Improved localization for Spanish",
          "description": "Enhanced text layout and font rendering for Spanish language.",
          "impact": "Medium",
          "user_visible": true
        },
        {
          "title": "Improved localization for French",
          "description": "Enhanced text layout and special character handling for French language.",
          "impact": "Medium",
          "user_visible": true
        },
        {
          "title": "Improved localization for German",
          "description": "Fixed text overflow and alignment issues in German dialogue.",
          "impact": "Medium",
          "user_visible": true
        },
        {
          "title": "Optimized voice clip management",
          "description": "Reduced memory usage and improved loading times for voice clips.",
          "impact": "Medium",
          "user_visible": false
        },
        {
          "title": "Enhanced animation system performance",
          "description": "Improved animation rendering efficiency and reduced stuttering.",
          "impact": "Medium",
          "user_visible": true
        },
        {
          "title": "Improved memory management",
          "description": "Optimized memory allocation and reduced fragmentation.",
          "impact": "Medium",
          "user_visible": false
        }
      ]
