    {
      "stage": 4,
      "name": "GT Black Star intro",
      "inputs": [
        "BLACK_STAR_RADAR",
        "BLACK_STAR_1",
        "GENERAL_RILDO"
      ],
      "gate": "LOG2 mini-route stable"
    },
    {
      "stage": 5,
      "name": "Super route opener",
